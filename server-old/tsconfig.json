{
	"compilerOptions": {
		/* Visit https://aka.ms/tsconfig.json to read more about this file */

		/* Basic Options */
		// "incremental": true,                         /* Enable incremental compilation */
		"target": "ESNEXT",
		"module": "ES2020",
		"lib": ["es2021", "DOM"],
		"jsx": "react-jsx" /* Specify JSX code generation: 'preserve', 'react-native', 'react', 'react-jsx' or 'react-jsxdev'. */,
		"declaration": true /* Generates corresponding '.d.ts' file. */,
		"declarationMap": true /* Generates a sourcemap for each corresponding '.d.ts' file. */,
		"sourceMap": true /* Generates corresponding '.map' file. */,
		"noEmit": true /* Do not emit outputs. */,
		"isolatedModules": true /* Transpile each file as a separate module (similar to 'ts.transpileModule'). */,

		/* Strict Type-Checking Options */
		"strict": true /* Enable all strict type-checking options. */,
		"alwaysStrict": true /* Parse in strict mode and emit "use strict" for each source file. */,

		/* Module Resolution Options */
		"moduleResolution": "node" /* Specify module resolution strategy: 'node' (Node.js) or 'classic' (TypeScript pre-1.6). */,
		"esModuleInterop": true /* Enables emit interoperability between CommonJS and ES Modules via creation of namespace objects for all imports. Implies 'allowSyntheticDefaultImports'. */,
		"skipLibCheck": true /* Skip type checking of declaration files. */,
		"forceConsistentCasingInFileNames": true /* Disallow inconsistently-cased references to the same file. */,
		"composite": true,
		"rootDir": "..",
		"baseUrl": "..",
		"paths": {
			"@thorium/*": ["./shared/*"],
			"@server/*": ["./server/src/*"],
			"@client/*": ["./client/app/*"]
		}
	},
	"include": [
		"src/**/*",
		"../shared",
		"../client/app/**/data.ts",
		"../client/app/**/data.tsx",
		"../client/app/**/data/**/*.ts",
		"../client/app/**/data/**/*.tsx",
		"../client/app/utils/effects.tsx",
		"../client/tailwind.config.ts",
		"../client/tailwindComponents.ts",
		"../app/utils/unitTypes.ts",
		"../app/utils/ecs",
		"../app/.server/classes",
		"../app/utils/.server/appPaths.ts",
		"../app/utils/generateIncrementedName.ts",
		"../app/utils/operations/randomNameGenerator.ts",
		"../app/utils/operations/randomFromRange.ts",
		"../app/utils/operations/randomFromList.ts",
		"../app/utils/operations/mergeDeep.ts",
		"../app/utils/constants.ts",
		"../app/utils/.server/getInventoryTemplates.ts",
		"../app/.server/DataContext.ts",
		"../app/utils/.server/zodAutoForm.ts",
		"../app/utils/.server/evaluateEntityQuery.ts",
		"../app/utils/flags/actionSchema.ts",
		"../app/utils/.server/zip.ts",
		"../app/utils/starmap/getNavigationDistance.tsx",
		"../app/utils/starmap/getHabitableZone.ts",
		"../app/utils/starmap/position.ts",
		"../app/utils/.server/db-fs/loadFolderYaml.ts",
		"../app/utils/.server/getFlights.ts",
		"../app/utils/.server/inputAuth.ts",
		"../app/utils/.server/createMockDataContext.ts",
		"../app/utils/flags/InventoryFlags.ts",
		"../app/utils/.server/entityQuery.test.ts",
		"../app/utils/.server/ship/collisionDamage.ts",
		"../app/utils/.server/ship/getDeckNode.ts",
		"../app/utils/.server/ship/getShipSystem.ts",
		"../app/utils/.server/ship/getSystemInventory.ts",
		"../app/utils/.server/ship/shipMapPathfinder.test.ts",
		"../app/utils/.server/ship/shipMapPathfinder.ts",
		"../app/utils/.server/ship/priorityQueue.ts",
		"../app/utils/starmap/isPointWithinCone.test.ts",
		"../app/utils/starmap/isPointWithinCone.ts",
		"../app/utils/starmap/steering.ts"
	]
}
