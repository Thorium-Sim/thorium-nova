{
	"name": "thorium-nova",
	"version": "1.0.0-alpha.19",
	"private": true,
	"description": "Spaceship Simulator Controls Platform",
	"keywords": [],
	"license": "Apache 2.0",
	"author": "Alex Anderson",
	"repository": {
		"type": "git",
		"url": "https://github.com/Thorium-Sim/thorium-nova.git"
	},
	"type": "module",
	"publishConfig": {
		"access": "restricted"
	},
	"scripts": {
		"build": "run-s build:*",
		"build:client": "react-router build",
		"build:server": "bun run ./scripts/build.ts",
		"sign": "./scripts/notarize.sh",
		"dev": "run-p --race dev:*",
		"dev:client": "react-router dev",
		"dev:server": "bun run --watch ./app/bunServer.ts",
		"start": "bun ./build/server/index.js",
		"typecheck": "react-router typegen && tsgo",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"test": "is-ci-cli \"test:ci\" \"test:watch\"",
		"test:ci": "bun run --bun vitest",
		"test:watch": "bun run --bun vitest --watch",
		"test:e2e": "playwright test",
		"format": "oxfmt",
		"format:different": "oxfmt --check",
		"semantic-release": "semantic-release",
		"postinstall": "bun run init:plugin",
		"validate": "concurrently --names \"lint,format,typecheck,test\" -c \"yellow.bold,magenta.bold,blue.bold,green.bold\" \"bun run lint\" \"bun run format:different\" \"bun run typecheck\" \"CI=true bun run test\"",
		"init:plugin": "bun run scripts/pluginInit.ts",
		"sly": "npx @sly-cli/sly"
	},
