{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Thorium Nova",
	"version": "0.1.0",

	"identifier": "us.fyreworks.thorium-nova",
	"build": {
		"frontendDist": "./web"
	},
	"app": {
		"windows": [
			{
				"title": "Thorium Nova",
				"width": 1024,
				"height": 768,
				"alwaysOnTop": true,
				"maximized": false,
				"decorations": false,
				"resizable": true,
				"fullscreen": false,
				"minimizable": false,
				"closable": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"externalBin": ["binaries/thoriumNovaServer"],
		"icon": [
			"icons/32x32.png",
			"icons/64x64.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
