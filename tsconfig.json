{
	"include": [
		".react-router/types/**/*",
		"app/**/*",
		"app/**/.server/**/*",
		"app/**/.client/**/*",
		"tailwind.config.ts",
		"vite.config.ts",
		"scripts/**/*",
		".github/actions/**/*",
		"package.json",
		"app/components/NotFound/astronaut.json"
	],
	"compilerOptions": {
		"checkJs": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"composite": true,
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": ["vite/client", "bun"],
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"baseUrl": ".",
		"rootDirs": [".", "./.react-router/types"],
		"paths": {
			"@thorium/ui/*": ["./app/components/ui/*"],
			"@thorium/*": ["./app/*"],
			"@/icon-name": [
				"./app/components/ui/icons/name.d.ts",
				"./types/icon-name.d.ts"
			]
		},
		"esModuleInterop": true,
		"resolveJsonModule": true
	}
}
